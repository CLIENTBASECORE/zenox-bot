# Zenox Cinema Bot Configuration

# Discord Bot Credentials (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here

# Channel Configuration
ADMIN_CHANNEL_ID=your_admin_chat_channel_id_here
STAFF_CHANNEL_ID=your_admin_chat_channel_id_here
REQUESTS_CHANNEL_ID=your_requests_channel_id_here
NOWPLAYING_CHANNEL_ID=your_nowplaying_channel_id_here

# Optional: TMDB API Key for live cinema search (built-in 4K catalog included by default)
TMDB_API_KEY=your_tmdb_api_key_here

# Zenox Website Base URL
ZENOX_BASE_URL=https://zenox.lol
NODE_ENV=production
